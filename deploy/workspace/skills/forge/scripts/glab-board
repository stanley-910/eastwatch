#!/usr/bin/env bash
# glab-board — project-agnostic issue-board and issue-work lifecycle helper.
# Derives the forge host and project from the cwd repo's origin remote.
#
# Usage:
#   glab-board setup [--board]   bootstrap labels (+ GitHub Projects v2 board with --board; GitLab always gets lanes) (idempotent)
#   glab-board start <iid> [work|research]  create/reuse worktree + claim + record
#   glab-board finish <iid> [--description-file <path>] [--draft] [--verify-cmd <cmd>] [--skip-verify]
#   glab-board frontier            open + unblocked + unassigned issues
#   glab-board list                all open issues (iid | blocked | assignee | labels | title)
#   glab-board create --title TITLE [--description-file PATH] [--label LABEL ...]
#   glab-board view|show <iid>     issue body + comments
#   glab-board edit <iid> --description-file <path>
#   glab-board grab <iid> [work|research]  assign + agent status + record
#   glab-board ready <iid> [research]  promote to Ready / Ready-research
#   glab-board park <iid> [text]   set agent::parked, optional comment
#   glab-board note <iid> <text>   comment on an issue
#   glab-board close <iid> [text]  optional comment, clear agent status, close
#   glab-board block <A> <B>       mark issue A blocked-by issue B
#   glab-board mr [create-args]    push current branch, create/verify MR, record
#   glab-board triage              open issues labeled triage::pending
set -euo pipefail

die() {
  echo "glab-board: $*" >&2
  exit 1
}

remote=$(git remote get-url origin 2>/dev/null) || die "not in a git repo with an origin remote"

# git@host:group/proj.git | https://host/group/proj.git -> host + group/proj
case "$remote" in
git@*) host=${remote#git@}; host=${host%%:*}; path=${remote#*:} ;;
http*) host=${remote#*://}; path=${host#*/}; host=${host%%/*} ;;
*) die "unrecognized remote: $remote" ;;
esac
path=${path%.git}

FORGE=gitlab
[[ "$host" == "github.com" ]] && FORGE=github

if [[ "$FORGE" == "gitlab" ]]; then
  command -v glab >/dev/null || die "glab not installed"
  export GITLAB_HOST=$host
  ENC=$(printf '%s' "$path" | sed 's|/|%2F|g')
  PROJECT=$path
else
  command -v gh >/dev/null || die "gh not installed"
  PROJECT=$path
  owner=${PROJECT%%/*}
  repo=${PROJECT#*/}
fi

setup_gitlab_board() {
  local boards_json board_id labels_json lists_json lane label_id
  local lanes=(
    "triage::pending"
    "agent::ready"
    "agent::ready-research"
    "agent::working"
    "agent::researching"
    "agent::parked"
    "agent::mr-ready"
    "agent::failed"
    "agent::for-human"
  )

  boards_json=$(glab api "projects/$ENC/boards")
  board_id=$(printf '%s' "$boards_json" | python3 -c 'import json,sys; boards=json.load(sys.stdin); print(boards[0]["id"] if boards else "")')
  [[ -n "$board_id" ]] || die "project has no default board"

  labels_json=$(glab api "projects/$ENC/labels?per_page=100")
  lists_json=$(glab api "projects/$ENC/boards/$board_id/lists")
  for lane in "${lanes[@]}"; do
    label_id=$(printf '%s' "$labels_json" | python3 -c 'import json,sys; name=sys.argv[1]; print(next((str(label["id"]) for label in json.load(sys.stdin) if label["name"] == name), ""))' "$lane")
    if [[ -z "$label_id" ]]; then
      echo "skipped: list $lane (label missing)"
    elif printf '%s' "$lists_json" | python3 -c 'import json,sys; wanted=sys.argv[1]; raise SystemExit(0 if any(str((item.get("label") or {}).get("id")) == wanted for item in json.load(sys.stdin)) else 1)' "$label_id"; then
      echo "skipped: list $lane (already exists)"
    elif glab api -X POST "projects/$ENC/boards/$board_id/lists" -f "label_id=$label_id" >/dev/null 2>&1; then
      echo "list-added: $lane"
    else
      echo "skipped: list $lane (create failed)"
    fi
  done
}

setup_github_board() {
  local project_title viewer_id repository_id project_id create_json all_matches match_count
  local after="" page page_matches has_next end_cursor
  local status_json status_field_id status_body appended
  local find_query='query FindProject($owner:String!,$repo:String!,$after:String){viewer{id} repository(owner:$owner,name:$repo){id projectsV2(first:100,after:$after){nodes{id title} pageInfo{hasNextPage endCursor}}}}'
  project_title="$repo board"

  # Scan ALL pages (never a bounded first:N) and collect every title match so duplicates are
  # detected rather than silently pinning an arbitrary one.
  all_matches=""
  while :; do
    if [[ -n "$after" ]]; then
      page=$(gh api graphql -f query="$find_query" -F "owner=$owner" -F "repo=$repo" -F "after=$after")
    else
      page=$(gh api graphql -f query="$find_query" -F "owner=$owner" -F "repo=$repo")
    fi
    # One value per line (empty lines preserved) so an empty match list or cursor never collapses.
    { read -r viewer_id; read -r repository_id; read -r page_matches; read -r has_next; read -r end_cursor; } < <(printf '%s' "$page" | python3 -c '
import json, sys
title = sys.argv[1]
data = json.load(sys.stdin)["data"]
conn = data["repository"]["projectsV2"]
matches = [n["id"] for n in conn["nodes"] if n["title"] == title]
info = conn["pageInfo"]
print(data["viewer"]["id"])
print(data["repository"]["id"])
print(",".join(matches))
print("1" if info["hasNextPage"] else "0")
print(info["endCursor"] or "")
' "$project_title")
    [[ -n "$page_matches" ]] && all_matches+="${page_matches//,/$'\n'}"$'\n'
    [[ "$has_next" == "1" ]] || break
    after=$end_cursor
  done

  match_count=$(printf '%s' "$all_matches" | grep -c . || true)
  [[ -n "$match_count" ]] || match_count=0
  project_id=""
  if (( match_count > 1 )); then
    die "multiple projects titled '$project_title' are linked to $PROJECT; pin the canonical one: git config forge.githubProjectId <PVT_...>"
  elif (( match_count == 1 )); then
    project_id=$(printf '%s' "$all_matches" | grep .)
    echo "skipped: project $project_title (already linked)"
  else
    create_json=$(gh api graphql -f query='mutation CreateProject($ownerId:ID!,$title:String!){createProjectV2(input:{ownerId:$ownerId,title:$title}){projectV2{id}}}' -F "ownerId=$viewer_id" -F "title=$project_title")
    project_id=$(printf '%s' "$create_json" | python3 -c 'import json,sys; print(json.load(sys.stdin)["data"]["createProjectV2"]["projectV2"]["id"])')
    echo "created: project $project_title"
    gh api graphql -f query='mutation LinkProject($projectId:ID!,$repositoryId:ID!){linkProjectV2ToRepository(input:{projectId:$projectId,repositoryId:$repositoryId}){repository{id}}}' -F "projectId=$project_id" -F "repositoryId=$repository_id" >/dev/null
    echo "linked: project $project_title to $PROJECT"
  fi

  # Pin the canonical project node id per-clone (replace-all so a stale/ambiguous prior value is
  # collapsed to exactly one); every GitHub verb reads this and fails closed without it.
  git config --replace-all forge.githubProjectId "$project_id"
  echo "config: forge.githubProjectId=$project_id"

  status_json=$(gh api graphql -f query='query ProjectStatus($projectId:ID!){node(id:$projectId){... on ProjectV2{fields(first:100){nodes{... on ProjectV2SingleSelectField{id name options{id name color description}}}}}}}' -F "projectId=$project_id")
  status_field_id=$(printf '%s' "$status_json" | python3 -c 'import json,sys; fields=json.load(sys.stdin)["data"]["node"]["fields"]["nodes"]; print(next((field["id"] for field in fields if field.get("name") == "Status"), ""))')
  [[ -n "$status_field_id" ]] || die "project has no Status field"

  # Append any missing desired options while preserving every existing option (and its card
  # assignments) by re-sending it with its id. updateProjectV2Field replaces the whole list, so
  # a dropped name would orphan its cards, including Closed. First stdout line = appended names,
  # second line = the mutation body; empty output = nothing missing.
  status_body=$(printf '%s' "$status_json" | python3 -c '
import json, sys
field_id = sys.argv[1]
desired = [("Triage","YELLOW"),("Needs-info","YELLOW"),("Ready","GREEN"),("Ready-research","GREEN"),("Working","BLUE"),("Researching","BLUE"),("Parked","ORANGE"),("Review","PURPLE"),("Failed","RED"),("For-human","GRAY")]
fields = json.load(sys.stdin)["data"]["node"]["fields"]["nodes"]
field = next(f for f in fields if f.get("name") == "Status")
existing = field["options"]
existing_names = [o["name"] for o in existing]
missing = [(n, c) for n, c in desired if n not in existing_names]
if not missing:
    raise SystemExit(0)
options = [{"id": o["id"], "name": o["name"], "color": o["color"], "description": o.get("description") or ""} for o in existing]
options += [{"name": n, "color": c, "description": ""} for n, c in missing]
print(",".join(n for n, _ in missing))
print(json.dumps({"query": "mutation UpdateStatus($fieldId:ID!,$options:[ProjectV2SingleSelectFieldOptionInput!]!){updateProjectV2Field(input:{fieldId:$fieldId,singleSelectOptions:$options}){projectV2Field{... on ProjectV2SingleSelectField{id}}}}", "variables": {"fieldId": field_id, "options": options}}))
' "$status_field_id")

  if [[ -z "$status_body" ]]; then
    echo "skipped: status lanes (already present)"
  else
    appended=$(printf '%s\n' "$status_body" | sed -n '1p')
    printf '%s\n' "$status_body" | sed -n '2,$p' | gh api graphql --input - >/dev/null
    echo "appended: status lanes ($appended)"
  fi

  echo "manual: switch project view layout to Board (GitHub API unsupported)"
  echo "manual: enable workflow Auto-add (is:issue is:open; GitHub API unsupported)"
  echo "manual: enable workflow Item-added -> Status=Triage (GitHub API unsupported)"
}

AGENT_LABELS=(agent::ready agent::ready-research agent::working agent::researching agent::parked agent::mr-ready agent::failed agent::for-human)

# --- GitHub canonical-project Status helpers ------------------------------------------------
# The canonical Projects v2 board's Status is authoritative on GitHub; lifecycle labels there are
# a watcher-owned shadow that glab-board never writes.

gh_project_id() { # echo the pinned canonical project node id, or die (fail closed on absent/ambiguous)
  local ids count
  ids=$(git config --get-all forge.githubProjectId 2>/dev/null || true)
  [[ -n "$ids" ]] || die "GitHub canonical project unset; run 'glab-board setup --board' first"
  count=$(printf '%s\n' "$ids" | grep -c . || true)
  [[ "$count" == "1" ]] || die "forge.githubProjectId is ambiguous ($count values); pin one: git config --replace-all forge.githubProjectId <PVT_...>"
  [[ "$ids" == PVT_* ]] || die "forge.githubProjectId '$ids' is not a project node id; run 'glab-board setup --board'"
  printf '%s' "$ids"
}

gh_item_status() { # <item_id> -> Status option name ("" when unset)
  gh api graphql -f query='query ItemStatus($itemId:ID!){node(id:$itemId){... on ProjectV2Item{fieldValueByName(name:"Status"){... on ProjectV2ItemFieldSingleSelectValue{name}}}}}' -F "itemId=$1" \
    | python3 -c 'import json,sys; v=json.load(sys.stdin)["data"]["node"]["fieldValueByName"]; print((v or {}).get("name") or "")'
}

# gh_set_status <iid> <status-name>: resolve everything per call, fail closed, fence the
# Item-added->Triage workflow when we add the item, then write and verify by read-back.
gh_set_status() {
  local iid=$1 status=$2 pid issue_id issue_state item_id
  local fields_json field_id option_id readback attempt current observed
  local after="" page has_next end_cursor
  local fence_attempts=${GLAB_BOARD_FENCE_ATTEMPTS:-30}
  local fence_interval=${GLAB_BOARD_FENCE_INTERVAL:-1}
  pid=$(gh_project_id)

  # Resolve the issue node id, state, and whether it already has an item in the canonical
  # project — paginating associations so a canonical item on a later page is never missed.
  issue_id=""; issue_state=""; item_id=""
  while :; do
    if [[ -n "$after" ]]; then
      page=$(gh api graphql -f query='query IssueItem($owner:String!,$repo:String!,$number:Int!,$after:String){repository(owner:$owner,name:$repo){issue(number:$number){id state projectItems(first:100,after:$after){nodes{id project{id}} pageInfo{hasNextPage endCursor}}}}}' -F "owner=$owner" -F "repo=$repo" -F "number=$iid" -F "after=$after")
    else
      page=$(gh api graphql -f query='query IssueItem($owner:String!,$repo:String!,$number:Int!,$after:String){repository(owner:$owner,name:$repo){issue(number:$number){id state projectItems(first:100,after:$after){nodes{id project{id}} pageInfo{hasNextPage endCursor}}}}}' -F "owner=$owner" -F "repo=$repo" -F "number=$iid")
    fi
    { read -r issue_id; read -r issue_state; read -r item_id; read -r has_next; read -r end_cursor; } < <(printf '%s' "$page" | python3 -c '
import json, sys
pid = sys.argv[1]
issue = json.load(sys.stdin)["data"]["repository"]["issue"]
conn = issue["projectItems"]
item = next((it["id"] for it in conn["nodes"] if (it.get("project") or {}).get("id") == pid), "")
info = conn["pageInfo"]
print(issue["id"])
print(issue["state"])
print(item)
print("1" if info["hasNextPage"] else "0")
print(info["endCursor"] or "")
' "$pid")
    [[ -n "$item_id" || "$has_next" != "1" ]] && break
    after=$end_cursor
  done
  [[ "$issue_state" == "CLOSED" ]] && die "issue #$iid is closed; refusing to set Status"

  fields_json=$(gh api graphql -f query='query ProjectFields($projectId:ID!){node(id:$projectId){... on ProjectV2{fields(first:100){nodes{... on ProjectV2SingleSelectField{id name options{id name}}}}}}}' -F "projectId=$pid")
  read -r field_id option_id <<<"$(printf '%s' "$fields_json" | python3 -c '
import json, sys
status = sys.argv[1]
fields = json.load(sys.stdin)["data"]["node"]["fields"]["nodes"]
field = next((f for f in fields if f.get("name") == "Status"), None)
if not field:
    sys.exit(1)
opt = next((o for o in field["options"] if o["name"] == status), None)
if not opt:
    sys.exit(2)
print(field["id"], opt["id"])
' "$status")"
  [[ -n "$field_id" && -n "$option_id" ]] || die "Status option '$status' not found in canonical project"

  if [[ -z "$item_id" ]]; then
    item_id=$(gh api graphql -f query='mutation AddItem($projectId:ID!,$contentId:ID!){addProjectV2ItemById(input:{projectId:$projectId,contentId:$contentId}){item{id}}}' -F "projectId=$pid" -F "contentId=$issue_id" \
      | python3 -c 'import json,sys; print(json.load(sys.stdin)["data"]["addProjectV2ItemById"]["item"]["id"])')
    # Fence the Item-added->Triage workflow: wait until it lands a Status, else it would clobber
    # our write. Fail closed on timeout rather than racing an unfenced write.
    observed=false
    attempt=0
    while (( attempt < fence_attempts )); do
      current=$(gh_item_status "$item_id")
      [[ -n "$current" ]] && { observed=true; break; }
      attempt=$((attempt + 1))
      sleep "$fence_interval"
    done
    [[ "$observed" == true ]] || die "Item-added->Triage workflow set no Status for #$iid within timeout; refusing to write (enable the workflow or retry)"
  fi

  gh api graphql -f query='mutation SetStatus($projectId:ID!,$itemId:ID!,$fieldId:ID!,$optionId:String!){updateProjectV2ItemFieldValue(input:{projectId:$projectId,itemId:$itemId,fieldId:$fieldId,value:{singleSelectOptionId:$optionId}}){projectV2Item{id}}}' -F "projectId=$pid" -F "itemId=$item_id" -F "fieldId=$field_id" -F "optionId=$option_id" >/dev/null
  readback=$(gh_item_status "$item_id")
  [[ "$readback" == "$status" ]] || die "Status read-back mismatch for #$iid: wanted '$status', got '${readback:-<null>}'"
}

gl_agent_labels_csv() { # [keep]
  local l out=""
  for l in "${AGENT_LABELS[@]}"; do
    [[ "$l" == "${1:-}" ]] && continue
    out+="${out:+,}$l"
  done
  printf '%s' "$out"
}

setup_board() {
  local with_board=${1:-false}
  local row old new name color legacy_needs=needs legacy_ready=ready-for
  local renames=(
    "${legacy_needs}-triage|triage::pending"
    "${legacy_needs}-info|triage::needs-info"
    "${legacy_ready}-agent|agent::ready"
    "${legacy_ready}-research|agent::ready-research"
    "${legacy_ready}-human|agent::for-human"
  )
  local labels=(
    "triage::pending|#f0ad4e"
    "triage::needs-info|#f7e463"
    "agent::ready|#5cb85c"
    "agent::ready-research|#45b39d"
    "agent::for-human|#337ab7"
    "agent::mr-ready|#6f42c1"
    "agent::failed|#c0392b"
    "agent::working|#1f883d"
    "agent::researching|#33aaff"
    "agent::parked|#f0ad4e"
    "bug|#d9534f"
    "enhancement|#5bc0de"
    "hitl|#cc0033"
    "wontfix|#777777"
    "wayfinder:map|#6699cc"
    "wayfinder:research|#33aa33"
    "wayfinder:prototype|#ff9900"
    "wayfinder:grilling|#cc3399"
    "wayfinder:task|#8e8e8e"
  )

  for row in "${renames[@]}"; do
    IFS='|' read -r old new <<<"$row"
    if [[ "$FORGE" == "gitlab" ]]; then
      if glab api -X PUT "projects/$ENC/labels" -f "name=$old" -f "new_name=$new" >/dev/null 2>&1; then
        echo "renamed: $old -> $new"
      else
        echo "skipped: rename $old -> $new"
      fi
    elif gh label edit "$old" --name "$new" -R "$PROJECT" 2>/dev/null; then
      echo "renamed: $old -> $new"
    else
      echo "skipped: rename $old -> $new"
    fi
  done

  for row in "${labels[@]}"; do
    IFS='|' read -r name color <<<"$row"
    if [[ "$FORGE" == "gitlab" ]]; then
      if glab api -X POST "projects/$ENC/labels" -f "name=$name" -f "color=$color" >/dev/null 2>&1; then
        echo "created: label $name"
      else
        echo "skipped: label $name (already exists)"
      fi
    elif gh label create "$name" --color "${color#\#}" -R "$PROJECT" 2>/dev/null; then
      echo "created: label $name"
    else
      echo "skipped: label $name (already exists)"
    fi
  done

  if [[ "$FORGE" == "gitlab" ]]; then
    setup_gitlab_board
  elif [[ "$with_board" == true ]]; then
    setup_github_board
  else
    echo "labels bootstrapped (queue-only); rerun with 'setup --board' to bootstrap a Projects v2 board"
  fi
}

agent_link() {
  local al="$HOME/dotfiles/scripts/bin/agent-link"
  [[ -x "$al" ]] || return 0
  "$al" "$@" || true
}

me_id() {
  glab api user | python3 -c 'import sys,json;print(json.load(sys.stdin)["id"])'
}

project_id() {
  glab api "projects/$ENC" | python3 -c 'import sys,json;print(json.load(sys.stdin)["id"])'
}

graphql_blocked_iids() { # -> newline-separated iids of OPEN work items GraphQL's linked-items widget reports blocked
  glab api graphql -f query="{project(fullPath:\"$PROJECT\"){workItems(first:100,state:opened){nodes{iid widgets{... on WorkItemWidgetLinkedItems{blocked}}}}}}" | python3 -c '
import json, sys
nodes = json.load(sys.stdin, strict=False)["data"]["project"]["workItems"]["nodes"]
for n in nodes:
    if any(isinstance(w, dict) and w.get("blocked") for w in (n.get("widgets") or [])):
        print(n["iid"])
'
}

list_issues() {
  local gql_blocked
  gql_blocked=$(graphql_blocked_iids || true)
  glab api "projects/$ENC/issues?state=opened&per_page=100${1:-}" | python3 -c '
import json, sys
gql_blocked = set(sys.argv[1].split())
for i in sorted(json.load(sys.stdin, strict=False), key=lambda x: x["iid"]):
    assignee = i["assignees"][0]["username"] if i["assignees"] else "-"
    labels = ",".join(i["labels"])
    blocked = i.get("blocked", False) or str(i["iid"]) in gql_blocked
    print("#%s | blocked=%s | asg=%s | [%s] | %s" % (i["iid"], blocked, assignee, labels, i["title"]))' "$gql_blocked"
}

create_issue() {
  local title="" description_file="" arg response parsed number url labels_csv label
  local labels=()
  while [[ $# -gt 0 ]]; do
    arg=$1; shift
    case "$arg" in
    --title)
      [[ $# -gt 0 && ${1:-} != --* ]] || die "--title requires a value"
      title=$1; shift
      ;;
    --description-file)
      [[ $# -gt 0 && ${1:-} != --* ]] || die "--description-file requires a path"
      description_file=$1; shift
      ;;
    --label)
      [[ $# -gt 0 && ${1:-} != --* ]] || die "--label requires a value"
      labels+=("$1"); shift
      ;;
    *) die "unknown create option: $arg" ;;
    esac
  done

  [[ -n "$title" ]] || die "create requires --title"
  [[ "$title" =~ [^[:space:]] ]] || die "create title must not be blank"
  [[ -z "$description_file" || -f "$description_file" ]] || die "description file not found: $description_file"
  for label in ${labels[@]+"${labels[@]}"}; do
    [[ "$label" =~ [^[:space:]] ]] || die "create label must not be blank"
    [[ "$label" != *,* ]] || die "create label must not contain a comma; pass each label with a separate --label: $label"
  done

  if [[ "$FORGE" == "gitlab" ]]; then
    local gl_args=(-X POST "projects/$ENC/issues" -f "title=$title")
    [[ -z "$description_file" ]] || gl_args+=(-f "description=$(cat "$description_file")")
    if (( ${#labels[@]} )); then
      labels_csv=$(IFS=,; printf '%s' "${labels[*]}")
      gl_args+=(-f "labels=$labels_csv")
    fi
    response=$(glab api "${gl_args[@]}")
    parsed=$(printf '%s' "$response" | python3 -c 'import json,sys; d=json.load(sys.stdin, strict=False); print("%s\t%s" % (d["iid"], d["web_url"]))')
  else
    local gh_args=(-X POST "repos/$PROJECT/issues" -f "title=$title")
    [[ -z "$description_file" ]] || gh_args+=(-f "body=$(cat "$description_file")")
    for label in ${labels[@]+"${labels[@]}"}; do gh_args+=(-f "labels[]=$label"); done
    response=$(gh api "${gh_args[@]}")
    parsed=$(printf '%s' "$response" | python3 -c 'import json,sys; d=json.load(sys.stdin); print("%s\t%s" % (d["number"], d["html_url"]))')
  fi
  IFS=$'\t' read -r number url <<<"$parsed"
  printf 'created #%s: %s\n' "$number" "$url"
}

issue_json() {
  if [[ "$FORGE" == "gitlab" ]]; then
    glab api "projects/$ENC/issues/$1"
  else
    gh issue view "$1" -R "$PROJECT" --json number,title,url
  fi
}

issue_title() {
  if [[ "$FORGE" == "gitlab" ]]; then
    issue_json "$1" | python3 -c 'import sys,json;print(json.load(sys.stdin, strict=False)["title"])'
  else
    issue_json "$1" | python3 -c 'import sys,json;print(json.load(sys.stdin)["title"])'
  fi
}

issue_url() {
  if [[ "$FORGE" == "gitlab" ]]; then
    issue_json "$1" | python3 -c 'import sys,json;d=json.load(sys.stdin, strict=False);print(d.get("web_url") or d["url"])'
  else
    issue_json "$1" | python3 -c 'import sys,json;d=json.load(sys.stdin);print(d.get("web_url") or d["url"])'
  fi
}

record_issue() {
  local url
  url=$(issue_url "$1" 2>/dev/null || true)
  [[ -n "$url" ]] && agent_link issue "$url"
}

record_mr() {
  local url=$1
  [[ -n "$url" ]] && agent_link add mr "$url"
}

grab_label() {
  case "${1:-work}" in
  work | implement) echo "agent::working agent::parked,agent::researching" ;;
  research) echo "agent::researching agent::working,agent::parked" ;;
  *) die "grab mode must be work or research" ;;
  esac
}

grab_status() {
  case "${1:-work}" in
  work | implement) echo "Working" ;;
  research) echo "Researching" ;;
  *) die "grab mode must be work or research" ;;
  esac
}

grab_issue() {
  local iid=$1 mode=${2:-work}
  if [[ "$FORGE" == "gitlab" ]]; then
    local lbl remove
    read -r lbl remove <<<"$(grab_label "$mode")"
    glab api -X PUT "projects/$ENC/issues/$iid" -f assignee_ids="$(me_id)" \
      -f add_labels="$lbl" -f remove_labels="$remove" >/dev/null
    record_issue "$iid"
    echo "grabbed #$iid (assigned, $lbl, recorded)"
  else
    # GitHub: Status is authoritative; write it FIRST (fails closed on unset config / closed
    # issue), then assign the human claim. Write NO lifecycle labels.
    local status
    status=$(grab_status "$mode")
    gh_set_status "$iid" "$status"
    gh issue edit "$iid" -R "$PROJECT" --add-assignee @me >/dev/null
    record_issue "$iid"
    echo "grabbed #$iid (assigned, Status=$status, recorded)"
  fi
}

ready_issue() {
  local iid=$1 mode=${2:-} status gl_label state
  case "$mode" in
  "") status=Ready; gl_label=agent::ready ;;
  research) status=Ready-research; gl_label=agent::ready-research ;;
  *) die "usage: glab-board ready <iid> [research]" ;;
  esac
  if [[ "$FORGE" == "gitlab" ]]; then
    state=$(glab api "projects/$ENC/issues/$iid" | python3 -c 'import sys,json; print(json.load(sys.stdin, strict=False).get("state", ""))')
    [[ "$state" == "closed" ]] && die "issue #$iid is closed; refusing to mark ready"
    # Scoped agent::* swap is automatic; triage::* is a different scope, so remove it explicitly.
    glab api -X PUT "projects/$ENC/issues/$iid" -f add_labels="$gl_label" \
      -f remove_labels="triage::pending,triage::needs-info" >/dev/null
  else
    gh_set_status "$iid" "$status"
  fi
  record_issue "$iid"
  echo "ready #$iid ($status)"
}

default_remote_ref() {
  local ref
  ref=$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null || true)
  if [[ -n "$ref" ]]; then
    printf '%s\n' "${ref#refs/remotes/}"
  elif git show-ref --verify --quiet refs/remotes/origin/main; then
    echo origin/main
  elif git show-ref --verify --quiet refs/remotes/origin/master; then
    echo origin/master
  else
    die "cannot determine origin default branch"
  fi
}

default_branch() {
  local ref
  ref=$(default_remote_ref)
  printf '%s\n' "${ref#origin/}"
}

current_branch() {
  local branch
  branch=$(git branch --show-current)
  [[ -n "$branch" ]] || die "detached HEAD is not a valid MR source"
  printf '%s\n' "$branch"
}

require_clean_worktree() {
  [[ -z "$(git status --porcelain)" ]] || die "worktree has uncommitted or untracked changes"
}

slugify() {
  python3 - "$1" <<'PY'
import re, sys
slug = re.sub(r"[^a-z0-9]+", "-", sys.argv[1].casefold()).strip("-")
print(slug[:60].rstrip("-"))
PY
}

worktree_for_branch() {
  local branch=$1
  git worktree list --porcelain | awk -v wanted="refs/heads/$branch" '
    $1 == "worktree" { path = substr($0, 10) }
    $1 == "branch" && $2 == wanted { print path; exit }
  '
}

print_start_result() {
  local iid=$1 worktree=$2 branch=$3 base=$4 json=${5:-false}
  if [[ "$json" == true ]]; then
    python3 - "$iid" "$worktree" "$branch" "$base" "$(issue_url "$iid")" <<'PY'
import json, sys
print(json.dumps({
    "issue": int(sys.argv[1]),
    "worktree": sys.argv[2],
    "branch": sys.argv[3],
    "base": sys.argv[4],
    "issue_url": sys.argv[5],
}, separators=(",", ":")))
PY
  else
    printf 'started #%s\nworktree: %s\nbranch: %s\nbase: %s\n' "$iid" "$worktree" "$branch" "$base"
  fi
}

start_issue() {
  local iid=$1 mode=${2:-work} json=${3:-false}
  [[ "$iid" =~ ^[0-9]+$ ]] || die "start requires a numeric issue iid"
  [[ "$mode" == work || "$mode" == research ]] || die "start mode must be work or research"
  # Fail closed before any worktree side effect: on GitHub the claim needs the pinned project id.
  [[ "$FORGE" != "github" ]] || gh_project_id >/dev/null

  local title slug branch base existing root project_name run_slug worktree
  title=$(issue_title "$iid")
  slug=$(slugify "$title")
  branch="issue-$iid-$slug"
  base=$(default_remote_ref)
  existing=$(worktree_for_branch "$branch")

  if [[ -n "$existing" ]]; then
    worktree=$existing
  else
    if [[ -n "$(git status --porcelain)" ]]; then
      echo "glab-board: warning: shared checkout is dirty; local changes are excluded from the issue worktree" >&2
    fi
    git fetch origin "${base#origin/}" >/dev/null
    root=${WORKTREE_ROOT:-$HOME/worktrees}
    project_name=$(basename "$path")
    run_slug="$(date +%F)_issue-$iid-$slug"
    worktree="$root/$project_name/$run_slug"
    mkdir -p "$(dirname "$worktree")"
    if git show-ref --verify --quiet "refs/heads/$branch"; then
      git worktree add "$worktree" "$branch" >/dev/null
    elif git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
      git worktree add -b "$branch" "$worktree" "origin/$branch" >/dev/null
    else
      git worktree add -b "$branch" "$worktree" "$base" >/dev/null
    fi
  fi

  (cd "$worktree" && grab_issue "$iid" "$mode") >&2
  print_start_result "$iid" "$worktree" "$branch" "$base" "$json"
}

arg_value() {
  local wanted=$1; shift
  local prev="" arg
  for arg in "$@"; do
    if [[ "$prev" == "$wanted" ]]; then
      printf '%s\n' "$arg"
      return 0
    fi
    case "$arg" in
    "$wanted"=*) printf '%s\n' "${arg#*=}"; return 0 ;;
    esac
    prev=$arg
  done
  return 1
}

has_arg() {
  local wanted=$1; shift; local arg
  for arg in "$@"; do
    [[ "$arg" == "$wanted" || "$arg" == "$wanted"=* ]] && return 0
  done
  return 1
}

prepare_source_branch() {
  local source=$1 target=$2 current ahead
  current=$(current_branch)
  [[ "$source" == "$current" ]] || die "requested source branch '$source' does not match current branch '$current'"
  [[ "$source" != "$target" && "$source" != main && "$source" != master ]] || die "refusing to create an MR from protected/default branch '$source'"
  require_clean_worktree
  git fetch origin "$target" >/dev/null
  ahead=$(git rev-list --count "origin/$target..HEAD")
  [[ "$ahead" -gt 0 ]] || die "branch '$source' has no commits over origin/$target"
  git push -u origin "HEAD:$source" >/dev/null
}

verify_gitlab_mr() {
  local url=$1 source=$2 target=$3 expect_draft=$4 iid
  iid=$(printf '%s\n' "$url" | sed -nE 's|.*/merge_requests/([0-9]+).*|\1|p')
  [[ -n "$iid" ]] || die "cannot parse merge request iid from: $url"
  local mr_json
  mr_json=$(glab api "projects/$ENC/merge_requests/$iid")
  printf '%s' "$mr_json" | python3 -c '
import json, sys
source, target, expect_draft = sys.argv[1], sys.argv[2], sys.argv[3] == "true"
mr = json.load(sys.stdin, strict=False)
errors = []
if mr.get("source_branch") != source:
    errors.append(f"source is {mr.get('source_branch')!r}, expected {source!r}")
if mr.get("target_branch") != target:
    errors.append(f"target is {mr.get('target_branch')!r}, expected {target!r}")
if bool(mr.get("draft")) != expect_draft:
    errors.append(f"draft is {bool(mr.get('draft'))}, expected {expect_draft}")
if str(mr.get("changes_count") or "") == "0":
    errors.append("merge request has no changes")
if errors:
    raise SystemExit("glab-board: MR verification failed: " + "; ".join(errors))
print(mr.get("web_url") or "")
' "$source" "$target" "$expect_draft"
}

gitlab_mr_iid() {
  printf '%s\n' "$1" | sed -nE 's|.*/merge_requests/([0-9]+).*|\1|p'
}

ensure_gitlab_mr_state() {
  local url=$1 expect_draft=$2 iid actual_draft
  iid=$(gitlab_mr_iid "$url")
  [[ -n "$iid" ]] || die "cannot parse merge request iid from: $url"
  actual_draft=$(glab api "projects/$ENC/merge_requests/$iid" | python3 -c 'import sys,json;print(str(bool(json.load(sys.stdin, strict=False).get("draft"))).lower())')
  [[ "$actual_draft" == "$expect_draft" ]] && return 0
  if [[ "$expect_draft" == true ]]; then
    glab mr update "$iid" -R "$PROJECT" --draft >/dev/null
  else
    glab mr update "$iid" -R "$PROJECT" --ready >/dev/null
  fi
}

create_gitlab_mr() {
  local args=("$@") source target expect_draft=false out url verified
  source=$(arg_value --source-branch "${args[@]}" || arg_value -s "${args[@]}" || current_branch)
  target=$(arg_value --target-branch "${args[@]}" || arg_value -b "${args[@]}" || default_branch)
  has_arg --draft "${args[@]}" && expect_draft=true
  prepare_source_branch "$source" "$target"
  if ! has_arg --source-branch "${args[@]}" && ! has_arg -s "${args[@]}"; then
    args+=(--source-branch "$source")
  fi
  if ! has_arg --target-branch "${args[@]}" && ! has_arg -b "${args[@]}"; then
    args+=(--target-branch "$target")
  fi
  out=$(glab mr create "${args[@]}" 2>&1) || { printf '%s\n' "$out" >&2; exit 1; }
  printf '%s\n' "$out"
  url=$(printf '%s\n' "$out" | /usr/bin/grep -oE 'https?://[^[:space:]]+/-/merge_requests/[0-9]+' | head -1)
  [[ -n "$url" ]] || die "glab did not return a merge request URL"
  ensure_gitlab_mr_state "$url" "$expect_draft"
  verified=$(verify_gitlab_mr "$url" "$source" "$target" "$expect_draft")
  [[ -n "$verified" ]] && url=$verified
  record_mr "$url"
  printf 'verified MR: %s\n' "$url"
}

create_github_pr() {
  local args=("$@") source target expect_draft=false out url
  source=$(arg_value --head "${args[@]}" || current_branch)
  target=$(arg_value --base "${args[@]}" || default_branch)
  has_arg --draft "${args[@]}" && expect_draft=true
  prepare_source_branch "$source" "$target"
  if ! has_arg --head "${args[@]}"; then args+=(--head "$source"); fi
  if ! has_arg --base "${args[@]}"; then args+=(--base "$target"); fi
  out=$(gh pr create -R "$PROJECT" "${args[@]}" 2>&1) || { printf '%s\n' "$out" >&2; exit 1; }
  printf '%s\n' "$out"
  url=$(printf '%s\n' "$out" | /usr/bin/grep -oE 'https?://[^[:space:]]+/pull/[0-9]+' | head -1)
  [[ -n "$url" ]] || die "gh did not return a pull request URL"
  local pr_json
  pr_json=$(gh pr view "$url" -R "$PROJECT" --json headRefName,baseRefName,isDraft,files)
  python3 - "$source" "$target" "$expect_draft" "$pr_json" <<'PY'
import json, sys
source,target=sys.argv[1:3]; draft=sys.argv[3]=="true"; pr=json.loads(sys.argv[4])
assert pr["headRefName"] == source, "source branch mismatch"
assert pr["baseRefName"] == target, "target branch mismatch"
assert bool(pr["isDraft"]) == draft, "draft state mismatch"
assert pr.get("files"), "pull request has no changes"
PY
  record_mr "$url"
  printf 'verified PR: %s\n' "$url"
}

write_mr_description() {
  local iid=$1 target=$2 description_file=$3 verification=$4 output=$5 marker
  marker="<!-- eastwatch: source_project=$PROJECT source_issue_iid=$iid conversation_key=$iid -->"

  if [[ -n "$description_file" ]]; then
    cat "$description_file" > "$output"
  else
    {
      printf '## Summary\n\n'
      git log --reverse --format='- %s' "origin/$target..HEAD"
      printf '\n\n## Verification\n\n- %s\n' "$verification"
    } > "$output"
  fi

  if ! grep -Eiq "(close[sd]?|fix(e[sd])?|resolve[sd]?) +#$iid([^0-9]|$)" "$output"; then
    printf '\n\nCloses #%s\n' "$iid" >> "$output"
  fi
  if ! grep -Fq "source_project=$PROJECT source_issue_iid=$iid conversation_key=$iid" "$output"; then
    printf '\n%s\n' "$marker" >> "$output"
  fi
}

finish_issue() {
  local iid=$1; shift
  local draft=false verify_cmd="" skip_verify=false description_file="" verification="" arg
  while [[ $# -gt 0 ]]; do
    arg=$1; shift
    case "$arg" in
    --description-file) [[ $# -gt 0 ]] || die "--description-file requires a path"; description_file=$1; shift ;;
    --draft) draft=true ;;
    --skip-verify) skip_verify=true ;;
    --verify-cmd) [[ $# -gt 0 ]] || die "--verify-cmd requires a command"; verify_cmd=$1; shift ;;
    *) die "unknown finish option: $arg" ;;
    esac
  done
  if [[ -n "$description_file" ]]; then
    [[ -f "$description_file" ]] || die "description file not found: $description_file"
    grep -q '[^[:space:]]' "$description_file" || die "description file is empty: $description_file"
  fi

  local branch target title desc existing_url=""
  branch=$(current_branch)
  target=$(default_branch)
  [[ "$branch" == issue-"$iid"-* ]] || die "current branch '$branch' is not the Forge branch for issue #$iid"
  require_clean_worktree

  if [[ "$skip_verify" == true ]]; then
    verification="Skipped with --skip-verify"
  elif [[ -n "$verify_cmd" ]]; then
    /bin/zsh -lc "$verify_cmd"
    verification="$verify_cmd"
  elif [[ -x .agent/verify ]]; then
    .agent/verify
    verification=".agent/verify"
  elif [[ -x scripts/verify-agent-change ]]; then
    scripts/verify-agent-change
    verification="scripts/verify-agent-change"
  else
    git diff --check "origin/$target...HEAD"
    verification="git diff --check origin/$target...HEAD"
  fi
  require_clean_worktree

  title=$(issue_title "$iid")
  desc=$(mktemp "${TMPDIR:-/tmp}/glab-board-mr.XXXXXX")
  trap 'rm -f "${desc:-}"' RETURN
  write_mr_description "$iid" "$target" "$description_file" "$verification" "$desc"

  if [[ "$FORGE" == "gitlab" ]]; then
    existing_url=$(glab api "projects/$ENC/merge_requests?state=opened&source_branch=$branch&per_page=1" | python3 -c 'import sys,json;d=json.load(sys.stdin, strict=False);print(d[0]["web_url"] if d else "")')
    if [[ -n "$existing_url" ]]; then
      prepare_source_branch "$branch" "$target"
      if [[ -n "$description_file" ]]; then
        glab api -X PUT "projects/$ENC/merge_requests/$(gitlab_mr_iid "$existing_url")" -f description="$(cat "$desc")" >/dev/null
      fi
      ensure_gitlab_mr_state "$existing_url" "$draft"
      verify_gitlab_mr "$existing_url" "$branch" "$target" "$draft" >/dev/null
      record_mr "$existing_url"
      printf 'finished #%s\nverified existing MR: %s\n' "$iid" "$existing_url"
      return 0
    fi
    local mr_args=(--title "$title" --description "$(cat "$desc")" --yes)
    [[ "$draft" == true ]] && mr_args+=(--draft)
    create_gitlab_mr "${mr_args[@]}"
  else
    existing_url=$(gh pr list -R "$PROJECT" --head "$branch" --state open --json url -q '.[0].url // ""')
    if [[ -n "$existing_url" ]]; then
      prepare_source_branch "$branch" "$target"
      [[ -z "$description_file" ]] || gh pr edit "$existing_url" -R "$PROJECT" --body-file "$desc"
      record_mr "$existing_url"
      printf 'finished #%s\nverified existing PR: %s\n' "$iid" "$existing_url"
      return 0
    fi
    local pr_args=(--title "$title" --body-file "$desc")
    [[ "$draft" == true ]] && pr_args+=(--draft)
    create_github_pr "${pr_args[@]}"
  fi
  printf 'finished #%s\n' "$iid"
}

cmd=${1:-help}

case "$cmd" in
setup)
  board=false
  [[ ${2:-} == --board ]] && board=true
  setup_board "$board"
  ;;
start)
  [[ $# -ge 2 ]] || die "usage: glab-board start <iid> [work|research] [--json]"
  mode=work; json=false
  [[ ${3:-} == work || ${3:-} == research ]] && mode=$3
  [[ ${3:-} == --json || ${4:-} == --json ]] && json=true
  start_issue "$2" "$mode" "$json"
  ;;
finish)
  [[ $# -ge 2 ]] || die "usage: glab-board finish <iid> [--description-file <path>] [--draft] [--verify-cmd <cmd>] [--skip-verify]"
  iid=$2; shift 2; finish_issue "$iid" "$@"
  ;;
frontier)
  if [[ "$FORGE" == "gitlab" ]]; then
    list_issues | awk -F' \\| ' '$2 == "blocked=False" && $3 == "asg=-" && $4 !~ /agent::(working|researching|parked)/'
  else
    gh issue list -R "$PROJECT" --state open --limit 100 --json number,title,labels,assignees,blockedBy | python3 -c '
import json, sys
for i in json.load(sys.stdin):
    blocked = any(b["state"] == "OPEN" for b in i["blockedBy"]["nodes"])
    if not i["assignees"] and not blocked:
        labels = ",".join(label["name"] for label in i["labels"])
        print("#%s | blocked=False | asg=- | [%s] | %s" % (i["number"], labels, i["title"]))'
  fi
  ;;
list)
  if [[ "$FORGE" == "gitlab" ]]; then list_issues; else gh issue list -R "$PROJECT" --state open --limit 100; fi
  ;;
create)
  shift
  create_issue "$@"
  ;;
view | show)
  [[ $# -ge 2 && -n ${2:-} ]] || die "usage: glab-board view|show <iid>"
  if [[ "$FORGE" == "gitlab" ]]; then glab issue view "$2" -R "$PROJECT" --comments; else gh issue view "$2" -R "$PROJECT" --comments; fi
  ;;
edit)
  [[ ${3:-} == --description-file && -n ${4:-} ]] || die "usage: glab-board edit <iid> --description-file <path>"
  [[ -f $4 ]] || die "description file not found: $4"
  if [[ "$FORGE" == "gitlab" ]]; then
    glab api -X PUT "projects/$ENC/issues/$2" -f description="$(cat "$4")" >/dev/null
  else
    gh issue edit "$2" -R "$PROJECT" --body-file "$4" >/dev/null
  fi
  echo "updated #$2 description"
  ;;
grab)
  grab_issue "$2" "${3:-work}"
  ;;
ready)
  [[ $# -ge 2 ]] || die "usage: glab-board ready <iid> [research]"
  ready_issue "$2" "${3:-}"
  ;;
park)
  if [[ "$FORGE" == "gitlab" ]]; then
    if [[ $# -ge 3 ]]; then glab issue note "$2" -R "$PROJECT" -m "$3"; fi
    glab api -X PUT "projects/$ENC/issues/$2" -f add_labels="agent::parked" -f remove_labels="$(gl_agent_labels_csv agent::parked)" >/dev/null
  else
    # Write Status first (fails closed) before any comment side effect.
    gh_set_status "$2" "Parked"
    if [[ $# -ge 3 ]]; then gh issue comment "$2" -R "$PROJECT" -b "$3"; fi
  fi
  echo "parked #$2"
  ;;
note)
  if [[ "$FORGE" == "gitlab" ]]; then glab issue note "$2" -R "$PROJECT" -m "$3"; else gh issue comment "$2" -R "$PROJECT" -b "$3"; fi
  ;;
close)
  if [[ "$FORGE" == "gitlab" ]]; then
    if [[ $# -ge 3 ]]; then glab issue note "$2" -R "$PROJECT" -m "$3"; fi
    glab api -X PUT "projects/$ENC/issues/$2" -f state_event=close -f remove_labels="$(gl_agent_labels_csv)" >/dev/null
  else
    if [[ $# -ge 3 ]]; then gh issue comment "$2" -R "$PROJECT" -b "$3"; fi
    # Status left alone: Closed is Stanley's project workflow, outside reconciliation.
    gh issue close "$2" -R "$PROJECT"
  fi
  echo "closed #$2"
  ;;
mr)
  shift
  if [[ "$FORGE" == "gitlab" ]]; then create_gitlab_mr "$@"; else create_github_pr "$@"; fi
  ;;
block)
  if [[ "$FORGE" == "gitlab" ]]; then
  glab api -X POST "projects/$ENC/issues/$2/links" -f target_project_id="$(project_id)" -f target_issue_iid="$3" -f link_type=is_blocked_by >/dev/null
  else
    gh issue edit "$2" -R "$PROJECT" --add-blocked-by "$3" >/dev/null
  fi
  echo "#$2 is now blocked by #$3"
  ;;
triage)
  if [[ "$FORGE" == "gitlab" ]]; then
    glab api "projects/$ENC/issues?state=opened&labels=triage::pending&per_page=100" | python3 -c '
import json, sys
for i in json.load(sys.stdin, strict=False): print("#%s | %s" % (i["iid"], i["title"]))'
  else
    gh issue list -R "$PROJECT" --state open --label triage::pending --limit 100
  fi
  ;;
*)
  /usr/bin/grep '^#   glab-board' "$0" | sed 's/^#   //'
  ;;
esac
